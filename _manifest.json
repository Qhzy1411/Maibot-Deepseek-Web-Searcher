{
  "manifest_version": 2,
  "id": "Qhzy1411.deepseek-web-searcher",
  "version": "1.0.1",
  "name": "Deepseek联网搜索",
  "description": "提供 DeepSeek 联网搜索与指定网页检索能力",
  "author": {
    "name": "Qhzy1411",
    "url": "https://github.com/Qhzy1411"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Qhzy1411/Maibot-Deepseek-Web-Searcher",
    "homepage": "https://github.com/Qhzy1411/Maibot-Deepseek-Web-Searcher",
    "documentation": "https://github.com/Qhzy1411/Maibot-Deepseek-Web-Searcher/blob/main/README.md",
    "issues": "https://github.com/Qhzy1411/Maibot-Deepseek-Web-Searcher/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.5.2",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "anthropic",
      "version_spec": ">=0.104.0,<1.0.0"
    },
    {
      "type": "python_package",
      "name": "maibot-plugin-sdk",
      "version_spec": ">=2.5.2,<3.0.0"
    }
  ],
  "plugin_type": "integration",
  "capabilities": [],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}